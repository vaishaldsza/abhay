# Gnani AI API Credentials
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URLS={"stt": "https://api.gnani.ai/stt", "llm": "https://api.gnani.ai/llm", "tts": "https://api.gnani.ai/tts"}
USE_MOCK_GNANI=true

# Database & Application
DATABASE_PATH=abhay.db
# Security Keys (All required with no default fallbacks; app fails at startup if missing or invalid)
# SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key
# PHONE_HASH_KEY: python -c "import secrets; print(secrets.token_hex(32))" (HMAC-SHA256 lookup key)
PHONE_HASH_KEY=replace-with-a-secure-random-hmac-key
# PHONE_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PHONE_ENCRYPTION_KEY=replace-with-a-valid-fernet-key-32-urlsafe-base64-bytes
DEMO_MODE=true
FLASK_APP=app.py
FLASK_ENV=development
